# Copier en .env (jamais commité) et remplir. Voir docs/deploiement.md.

# --- Serveur (obligatoire en production) -----------------------------------------
# Base MySQL 8 (fournie par docker-compose, ou une base managée chez l'hébergeur).
DATABASE_URL=mysql://balco:motdepasse@localhost:3306/balco
# Au moins 32 caractères aléatoires : openssl rand -base64 48
JWT_SECRET=
# Secret du cron des rappels : openssl rand -hex 24
CRON_SECRET=
# Envoi des codes de connexion. Ex. Brevo : smtps://LOGIN:CLE_SMTP@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM=Balco <bonjour@votre-domaine.fr>

# --- docker-compose uniquement ------------------------------------------------
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Connexion Apple / Google (facultatif : les boutons n'apparaissent que si c'est rempli) ---
# Identifiant(s) de bundle iOS, séparés par des virgules.
APPLE_AUDIENCES=
# Client IDs OAuth Google (iOS, Android, web), séparés par des virgules.
GOOGLE_CLIENT_IDS=

# --- Scanner et Nora (IA) ----------------------------------------------------------
# Clé de l'API Claude (console.anthropic.com). Vide = scanner et Nora « bientôt disponibles ».
ANTHROPIC_API_KEY=
# Modèle utilisé (défaut claude-opus-5). Voir docs/deploiement.md pour le coût.
BALCO_AI_MODEL=
# Quotas mensuels par compte (valeurs par défaut ci-dessous).
AI_FREE_SCANS_PER_MONTH=3
AI_FREE_QUESTIONS_PER_MONTH=15
AI_PLUS_SCANS_PER_MONTH=40
AI_PLUS_QUESTIONS_PER_MONTH=300

# --- Divers ---------------------------------------------------------------------
# Origines web supplémentaires autorisées à appeler l'API (l'app web servie par l'API n'en a pas besoin).
CORS_ORIGINS=

# --- Build de l'app mobile (EAS) ----------------------------------------------------
# Adresse publique de l'API, injectée dans l'app.
EXPO_PUBLIC_API_BASE_URL=https://api.votre-domaine.fr
# Identifiant de l'app sur les stores (domaine inversé, définitif après la 1re publication).
APP_BUNDLE_ID=fr.votre-domaine.balco
# Donné par `eas init` : nécessaire aux notifications push.
EAS_PROJECT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
