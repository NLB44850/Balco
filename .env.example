# Copier en .env (jamais commité) et remplir. Voir docs/deploiement.md.

# --- Serveur (obligatoire en production) -----------------------------------------
# Base MySQL 8 (fournie par docker-compose, ou une base managée chez l'hébergeur).
DATABASE_URL=mysql://balco:motdepasse@localhost:3306/balco
# Au moins 32 caractères aléatoires : openssl rand -base64 48
JWT_SECRET=
# Secret du cron des rappels : openssl rand -hex 24
CRON_SECRET=
# Envoi des codes de connexion. Ex. Brevo : smtps://LOGIN:CLE_SMTP@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM=Balco <bonjour@votre-domaine.fr>

# --- docker-compose uniquement ------------------------------------------------
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Connexion Apple / Google (facultatif : les boutons n'apparaissent que si c'est rempli) ---
# Identifiant(s) de bundle iOS, séparés par des virgules.
APPLE_AUDIENCES=
# Client IDs OAuth Google (iOS, Android, web), séparés par des virgules.
GOOGLE_CLIENT_IDS=

# --- Scanner et Nora (IA) ----------------------------------------------------------
# Clé de l'API Claude (console.anthropic.com). Vide = scanner et Nora « bientôt disponibles ».
ANTHROPIC_API_KEY=
# Modèle par usage : diagnostic photo (défaut claude-opus-5) et questions à Nora (défaut claude-sonnet-5).
# BALCO_AI_MODEL sert de repli commun quand la variable de l'usage est vide. Voir docs/deploiement.md.
BALCO_AI_MODEL_PHOTO=
BALCO_AI_MODEL_CHAT=
BALCO_AI_MODEL=
# Plafond de jetons de sortie, réflexion comprise (une réponse coupée n'est pas décomptée).
AI_MAX_TOKENS_PHOTO=2000
AI_MAX_TOKENS_CHAT=1500
# Budget IA du mois en dollars : à 80 %, Nora et le scanner font une pause pour les comptes gratuits ;
# à 100 %, pour tous, jusqu'au 1er du mois suivant. Vide = pas de limite (30 conseillé pendant les tests).
AI_MONTHLY_BUDGET_USD=
# Places au prix fondateur pour les premiers abonnés Balco+ (500 par défaut).
BALCO_FOUNDER_SEATS=
# Grille de prix par modèle en $ par million de jetons, pour corriger les tarifs sans toucher au code :
# AI_PRICES_JSON={"claude-opus-5":{"input":5,"output":25,"cacheRead":0.5,"cacheWrite":6.25}}
AI_PRICES_JSON=
# Quotas mensuels par compte : vides = ceux de l'offre (lib/plans.ts : gratuit 1 analyse et 5 questions,
# Balco+ 20 analyses et 100 questions). Une valeur ici les remplace (tests, lancement).
AI_FREE_SCANS_PER_MONTH=
AI_FREE_QUESTIONS_PER_MONTH=
AI_PLUS_SCANS_PER_MONTH=
AI_PLUS_QUESTIONS_PER_MONTH=

# --- Divers ---------------------------------------------------------------------
# Origines web supplémentaires autorisées à appeler l'API (l'app web servie par l'API n'en a pas besoin).
CORS_ORIGINS=

# --- Build de l'app mobile (EAS) ----------------------------------------------------
# Adresse publique de l'API, injectée dans l'app.
EXPO_PUBLIC_API_BASE_URL=https://api.votre-domaine.fr
# Identifiant de l'app sur les stores (domaine inversé, définitif après la 1re publication).
APP_BUNDLE_ID=fr.votre-domaine.balco
# Donné par `eas init` : nécessaire aux notifications push.
EAS_PROJECT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
